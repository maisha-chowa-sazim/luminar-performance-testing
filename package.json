{
  "name": "luminar-k6-performance-testing",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "test:smoke": "node k6/reporting/run.mjs smoke",
    "test:dashboard": "node k6/reporting/run.mjs --dashboard",
    "test:performance": "node k6/reporting/run.mjs",
    "test:reporting": "node --test k6/tests/*.test.mjs",
    "test:load:5": "ROLE_TOTAL_VUS=5 node k6/reporting/run.mjs load-roles",
    "test:load:10": "ROLE_TOTAL_VUS=10 node k6/reporting/run.mjs load-roles",
    "test:load:20": "ROLE_TOTAL_VUS=20 node k6/reporting/run.mjs load-roles",
    "test:load:arrival": "node k6/reporting/run.mjs load-arrival-rate",
    "test:roles": "node k6/reporting/run.mjs load-roles",
    "test:roles:smoke": "ROLE_TOTAL_VUS=2 ROLE_STEADY=30s ROLE_GRACE=2m ROLE_DRAIN=30s ROLE_THINK_SCALE=0 ROLE_MAX_WORKFLOWS_PER_VU=1 node k6/reporting/run.mjs load-roles",
    "test:roles:10": "ROLE_TOTAL_VUS=10 node k6/reporting/run.mjs load-roles",
    "test:roles:20": "ROLE_TOTAL_VUS=20 node k6/reporting/run.mjs load-roles",
    "test:roles:50": "ROLE_TOTAL_VUS=50 node k6/reporting/run.mjs load-roles",
    "test:load:50": "ROLE_TOTAL_VUS=50 node k6/reporting/run.mjs load-roles"
  },
  "dependencies": {
    "pdfkit": "0.17.2"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
