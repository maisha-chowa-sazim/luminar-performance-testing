{
  "name": "luminar-k6-performance-testing",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "test:smoke": "node k6/reporting/run.mjs smoke",
    "test:smoke:style": "node k6/reporting/run.mjs test-scenarios/style-smoke",
    "test:smoke:sample": "node k6/reporting/run.mjs test-scenarios/sample-smoke",
    "test:smoke:tech-pack": "node k6/reporting/run.mjs test-scenarios/tech-pack-smoke",
    "test:smoke:bom": "node k6/reporting/run.mjs test-scenarios/bom-smoke",
    "test:smoke:pre-costing": "node k6/reporting/run.mjs test-scenarios/pre-costing-smoke",
    "test:login:all": "node k6/reporting/run.mjs test-scenarios/login-all-users",
    "test:full-journey": "node k6/reporting/run.mjs full-journey",
    "test:roles": "node k6/reporting/run.mjs load-roles",
    "test:roles:smoke": "ROLE_TOTAL_VUS=2 ROLE_STEADY=30s ROLE_GRACE=2m ROLE_DRAIN=30s ROLE_THINK_SCALE=0 ROLE_MAX_WORKFLOWS_PER_VU=1 ROLE_STOP_ON_ERROR=1 node k6/reporting/run.mjs load-roles",
    "test:load:5": "node k6/reporting/run.mjs load-5-users",
    "test:load:10": "node k6/reporting/run.mjs load-10-users",
    "test:load:20": "node k6/reporting/run.mjs load-20-users",
    "test:load:50": "node k6/reporting/run.mjs load-50-users",
    "test:load:100": "node k6/reporting/run.mjs load-100-users",
    "test:load:arrival": "node k6/reporting/run.mjs load-arrival-rate",
    "test:dashboard": "node k6/reporting/run.mjs --dashboard",
    "test:performance": "node k6/reporting/run.mjs",
    "test:reporting": "node --test k6/tests/*.test.mjs",
    "report:regenerate": "node k6/reporting/regenerate.mjs"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
